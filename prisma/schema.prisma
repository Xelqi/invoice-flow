generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerStatus {
  Active
  Inactive
}

model Customer {
  id        String         @id @default(cuid())
  name      String
  email     String         @unique
  company   String
  status    CustomerStatus @default(Active)
  createdAt DateTime       @default(now())
}
